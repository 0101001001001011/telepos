# Cargo output. Large, machine-specific, and rebuilt by one command.
rust/target/

# Resolved dependency versions for a *package* are not committed: the
# consumer's constraints decide, not ours.
pubspec.lock
.dart_tool/

# The package became a Flutter FFI plugin, so the platform build systems now
# write scratch inside it. AGP puts its CMake scratch and its local SDK path in
# the *plugin* directory, not the application's, and both are machine-specific.
android/local.properties
android/.cxx/
.gradle/
build/
*.so
*.dll
*.dylib
*.a
*.lib
*.pdb
