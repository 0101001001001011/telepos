# Built artefacts never travel with the package: the consumer builds them.
rust/target/
.dart_tool/
build/

# Generated by `dart pub publish --dry-run` and by `pub get`. An application
# pins its dependencies; a package must not.
pubspec.lock

*.so
*.dll
*.dylib
*.a
*.lib
*.pdb

# The package became a Flutter FFI plugin, so the platform build systems now
# write scratch inside it. AGP puts its CMake scratch and its local SDK path in
# the *plugin* directory, not the application's, and both are machine-specific.
android/local.properties
android/.cxx/
.gradle/
build/
*.so
*.dll
*.dylib
*.a
*.lib
*.pdb
