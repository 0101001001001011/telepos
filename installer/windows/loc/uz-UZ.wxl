<?xml version="1.0" encoding="utf-8"?>
<!--
  Узбекский перевод окон установщика — ЛАТИНИЦЕЙ.

  Письменность выбрана по тому, на чём говорит сам продукт: словарь кассы
  (`assets/i18n/intl_uz.arb`) — латиница, и установщик, открывающийся перед
  ней, обязан совпадать. Две письменности подряд у одного продукта выглядят
  как две разные программы.

  ЗАЧЕМ СВОЙ ФАЙЛ. WixToolset.UI узбекского не везёт: сборка с `-culture
  uz-UZ` (и `uz-Latn-UZ` тоже) падает на `!(loc.WixUIOK)`. Казахский, к
  слову, есть — прежнее утверждение, что «WiX не везёт ни один из трёх»,
  было неверным и непроверенным.

  Разбор, что переводится, а что копируется дословно, — в `ky-KG.wxl`;
  здесь то же самое.
-->
<WixLocalization Culture="uz-UZ"
                 xmlns="http://wixtoolset.org/schemas/v4/wxl">

