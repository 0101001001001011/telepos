  <String Id="LicenseAgreementDlgBannerBitmap" Value="WixUI_Bmp_Banner" />
  <String Id="LicenseAgreementDlgTitle" Value="{\WixUI_Font_Title}Акыркы колдонуучу менен лицензиялык келишим" />
