<?xml version="1.0" encoding="utf-8"?>
<!--
  Кыргызский перевод окон установщика.

  ЗАЧЕМ СВОЙ ФАЙЛ. WixToolset.UI везёт переводы для многих языков, но
  кыргызского среди них нет: сборка с `-culture ky-KG` падает на
  `!(loc.WixUIOK)`. Казахский, к слову, есть — и прежнее утверждение, что
  «WiX не везёт ни один из трёх», было неверным и непроверенным.

  НАБОР СТРОК ИЗМЕРЕН, А НЕ УГАДАН: 204 идентификатора — ровно те, на
  которые ссылаются окна, включённые `WixUI_InstallDir`. Системные
  сообщения об ошибках (`Error*`) и подписи действий (`ProgressText*`) сюда
  не входят: их даёт сам установщик Windows на языке системы.

  ЧТО НЕ ПЕРЕВОДИТСЯ И ПОЧЕМУ. Часть значений — не текст: имена картинок
  (`WixUI_Bmp_Banner`), значков (`WixUI_Ico_Info`), разметка столбцов
  (`{120}{70}{70}{70}{70}`). Перевести их значило бы сломать окно. Они
  скопированы дословно.

  `[ProductName]`, `[1]`, `[2]` — подстановки установщика, их порядок и
  написание менять нельзя. `{\WixUI_Font_Title}` — указание шрифта, оно
  обязано остаться в начале строки.
-->
<WixLocalization Culture="ky-KG"
                 xmlns="http://wixtoolset.org/schemas/v4/wxl">

  <!-- ── Кнопки ─────────────────────────────────────────────────────── -->
  <String Id="WixUIBack" Value="&amp;Артка" />
  <String Id="WixUINext" Value="&amp;Кийинки" />
  <String Id="WixUICancel" Value="Жокко чыгаруу" />
  <String Id="WixUIFinish" Value="&amp;Бүттү" />
  <String Id="WixUIRetry" Value="&amp;Кайталоо" />
  <String Id="WixUIIgnore" Value="&amp;Көңүл бурбоо" />
  <String Id="WixUIYes" Value="&amp;Ооба" />
  <String Id="WixUINo" Value="&amp;Жок" />
  <String Id="WixUIOK" Value="OK" />
  <String Id="WixUIPrint" Value="&amp;Басып чыгаруу" />

  <!-- ── Приветствие ────────────────────────────────────────────────── -->
  <String Id="WelcomeDlg_Title" Value="[ProductName] орнотуу" />
